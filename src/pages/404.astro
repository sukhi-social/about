// 迷いこんだ人にも、やさしく。どちらの言葉も、ならべて出す。
import '../layouts/fonts';
import '../styles/about.css';
import { BASES, copy } from '../content';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 — sukhi</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" />
  </head>
  <body>
    <main class="lost">
      <p class="big" aria-hidden="true">(=・ω・=)?</p>
      {(['ja', 'en', 'ko'] as const).map((l) => (
        <section lang={l}>
          <h1 class="plain">{copy[l].notFound.title}</h1>
          <p>{copy[l].notFound.text}</p>
          <p><a class="button" href={BASES[l]}>{copy[l].notFound.back}</a></p>
        </section>
      ))}
    </main>
    <footer>
      <div></div>
      <p class="blessing" lang="en">Sukhī bhava!<br />Be Happy!</p>
    </footer>
  </body>
</html>
