---
// SPDX-License-Identifier: AGPL-3.0-or-later
import './fonts';
import '../styles/about.css';
import LangPicker from './LangPicker.astro';
import LangSuggest from './LangSuggest.astro';
import { CONTENT_LICENSE_URL, licensesCopy } from '../licenses-copy';
import { BASES, LOCALES, copy, LOGIN_URL, ORG_URL, SHOW_LOGIN, type Locale, type PageKey } from '../content';

interface Props {
  locale: Locale;
  page: PageKey;
  title: string;
  description: string;
}
const { locale, page, title, description } = Astro.props;
const c = copy[locale];
const base = BASES[locale];
const pathFor = (l: Locale, k: PageKey) => (k === 'gate' ? BASES[l] : `${BASES[l]}${k}/`);
const path = (k: PageKey) => pathFor(locale, k);
const keys: PageKey[] = ['gate', 'place', 'projects', 'atfedi', 'support'];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" />
    {LOCALES.map((l) => <link rel="alternate" hreflang={l.code} href={pathFor(l.code, page)} />)}
  </head>
  <body>
    <header class="bar">
      <a class="mark" href={base}>{c.siteName}</a>
      <div class="right">
        <LangPicker locale={locale} page={page} />
        {SHOW_LOGIN && <a class="button small" href={LOGIN_URL}>{c.login}</a>}
      </div>
    </header>
    <LangSuggest locale={locale} />
    <nav class="tabs" aria-label={c.navLabel}>
      {keys.map((k) => <a href={path(k)} aria-current={k === page ? 'page' : undefined}>{c.nav[k]}</a>)}
    </nav>

    <main><slot /></main>

    <footer>
      <div>
        <p>{c.footer}</p>
        <p><a href={ORG_URL}>github.com/sukhi-social</a> · <a href={path('licenses')}>{c.nav.licenses}</a></p>
        <p><a href={CONTENT_LICENSE_URL[locale]} rel="license">{licensesCopy[locale].footerContent}</a></p>
      </div>
      <p class="blessing" lang="en">Sukhī bhava!<br />Be Happy!</p>
    </footer>
  </body>
</html>
