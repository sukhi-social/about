---
// SPDX-License-Identifier: AGPL-3.0-or-later
// 言語のおすすめ。ブラウザの言語が、いまのページの言語とちがうときだけ、
// 上にそっと出す。勝手には移動しない(戻るボタンのわなや、読みたい言語を
// うばう心配があるため)。自分でえらんだ / 閉じたあとは、もう出さない。
import { SUGGEST, type Locale } from '../content';
interface Props { locale: Locale }
const { locale } = Astro.props;
---

<div class="lang-suggest" hidden data-current={locale} data-copy={JSON.stringify(SUGGEST)}>
  <p></p>
  <a class="go" href="#"></a>
  <button type="button" class="close"><svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M7 7l10 10M17 7L7 17" /></svg></button>
</div>

<script>
  const KEY = 'sukhi.about.lang';
  const box = document.querySelector<HTMLElement>('.lang-suggest');
  if (box) {
    try {
      const current = box.dataset.current!;
      const copy = JSON.parse(box.dataset.copy!) as Record<string, { text: string; go: string; close: string }>;
      const supported = Object.keys(copy);
      const wanted = (navigator.languages?.length ? navigator.languages : [navigator.language])
        .map((l) => l.toLowerCase().split('-')[0])
        .find((l) => supported.includes(l));
      const decided = localStorage.getItem(KEY);
      const link = wanted && document.querySelector<HTMLAnchorElement>(`.lang-picker li a[hreflang="${wanted}"]`);
      if (wanted && wanted !== current && !decided && link) {
        box.lang = wanted;
        box.querySelector('p')!.textContent = copy[wanted].text;
        const go = box.querySelector<HTMLAnchorElement>('.go')!;
        go.textContent = copy[wanted].go;
        go.href = link.href;
        go.hreflang = wanted;
        go.addEventListener('click', () => localStorage.setItem(KEY, wanted));
        const close = box.querySelector<HTMLButtonElement>('.close')!;
        close.setAttribute('aria-label', copy[wanted].close);
        close.addEventListener('click', () => {
          localStorage.setItem(KEY, current);
          box.hidden = true;
        });
        box.hidden = false;
      }
    } catch {
      // localStorage が使えないときは、何も出さない。
    }
  }
</script>
