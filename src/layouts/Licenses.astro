---
// SPDX-License-Identifier: AGPL-3.0-or-later
import Page from './Page.astro';
import { ABOUT_REPO_URL, copy, type Locale } from '../content';
import deps from '../generated/licenses.json';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = copy[locale].licenses;

// SPDX の識別子ひとつだけのときはリンクにする。「(MIT OR CC0-1.0)」のような式は、そのまま文字で。
const simple = (id: string) => /^[A-Za-z0-9.+-]+$/.test(id);
const spdx = (id: string) => `https://spdx.org/licenses/${id}.html`;
const fontFile = (name: string) => `/licenses/fonts/${name.split('/')[1]}-OFL.txt`;
---

<Page locale={locale} page="licenses" title={c.title} description={c.description}>
  <h1 class="plain">{c.heading}</h1>
  <p>{c.intro}</p>

  <h2>{c.selfHeading}</h2>
  <p>{c.self}</p>
  <p><a class="more" href={ABOUT_REPO_URL}>{c.selfLink} →</a></p>

  <h2>{c.shipHeading}</h2>
  {c.ship.map((t) => <p>{t}</p>)}
  <ul class="names deps">
    {deps.fonts.map((d) => (
      <li>
        <a href={d.href}>{d.name}</a> <span class="v">{d.version}</span>
        <a class="l" href={spdx(d.license)}>{d.license}</a>
        <span class="c">{d.copyright.join(' / ')}</span><br />
        <a class="l first" href={fontFile(d.name)}>{c.oflText}</a>
      </li>
    ))}
  </ul>

  <h2>{c.buildHeading}</h2>
  <p>{c.build}</p>
  <details class="deps">
    <summary>{c.buildHeading} <span class="n">{deps.build.length}</span></summary>
    <ul class="names">
      {deps.build.map((d) => (
        <li>
          <a href={d.href}>{d.name}</a> <span class="v">{d.version}</span>
          {simple(d.license) ? <a class="l" href={spdx(d.license)}>{d.license}</a> : <span class="l">{d.license}</span>}
          {d.copyright.length > 0 && <span class="c">{d.copyright.join(' / ')}</span>}
        </li>
      ))}
    </ul>
  </details>

  <p class="thanks">
    {c.thanks.map((t) => <span>{t}<br /></span>)}
  </p>
</Page>
